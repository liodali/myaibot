# Copy to scripts/gitea.env and fill in. git-ignored — contains a token.
# Keep values double-quoted.

# Your self-hosted Gitea base URL
GITEA_URL="http://gitea:3000"

# Gitea token with repo scope (UI: Settings → Applications)
GITEA_TOKEN=""

# Jenkins invoke URL including the ?token= of credential
# myaibot-webhook-token
JENKINS_WEBHOOK_URL="http://jenkins:8080/generic-webhook-trigger/invoke?token="

# Optional overrides (defaults shown):
# OWNER="liodali"
# REPO="myaibot"
# GITHUB_REPO="https://github.com/liodali/myaibot.git"
# MIRROR_INTERVAL="8h0m0s"
