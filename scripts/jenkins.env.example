# Copy to scripts/jenkins.env and fill in. git-ignored — contains an API token.
# Keep values double-quoted.

# Jenkins controller URL (reachable from this machine)
JENKINS_URL="https://jenkins.example.com"

# Jenkins admin user + API token (Profile → Security → API Token)
JENKINS_USER=""
JENKINS_API_TOKEN=""

# Global env vars to set on the controller (same values the seed/pipeline read)
GITEA_MIRROR="https://gitea.example.com/<owner>/myaibot.git"
GITEA_REGISTRY="gitea.example.com/<owner>/myaibot"
