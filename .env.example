# ---- Chatwoot ----
# Internal URL when this service runs next to Chatwoot on the same Podman network:
CHATWOOT_URL=http://chatwoot_rails_1:3000
# Public alternative:
# CHATWOOT_URL=https://chatwoot.example.com

# Agent Bot credentials — from `scripts/create-chatwoot-bot.sh` (bot.json)
BOT_TOKEN=
BOT_SECRET=

# ---- LLM (OpenAI-compatible) ----
# Groq:       https://api.groq.com/openai/v1        (model: llama-3.3-70b-versatile)
# OpenRouter: https://openrouter.ai/api/v1          (model: e.g. meta-llama/llama-3.3-70b-instruct)
# DeepSeek:   https://api.deepseek.com/v1           (model: deepseek-chat)
# OpenAI:     https://api.openai.com/v1             (model: gpt-4o-mini)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# ---- Bot behaviour ----
PORT=3000
SYSTEM_PROMPT=You are a friendly, concise customer support assistant. Reply in the customer's language. If a request needs account changes, private data, or you are unsure, reply with the token [HANDOFF] followed by a short reassuring message.
# Multi-project routing — two mechanisms, in order of precedence:
#   1. PROJECTS_MAP:        exact inbox ID -> project
#   2. PROJECTS_NAME_MAP:   inbox-name substring -> project (first match wins)
# Anything else falls back to DEFAULT_PROJECT. Examples:
# PROJECTS_MAP=9:wasfa
# PROJECTS_NAME_MAP=sovereign:sovereignledger,api.exchange:exchangeconvertapp,wasfa:wasfa
# DEFAULT_PROJECT=default
MAX_HISTORY=10
ONLY_WHEN_PENDING=true
HANDOFF_KEYWORD=[HANDOFF]
LOG_LEVEL=info
